$unicam-passoptions.latex()$
\documentclass[
$for(babel-otherlangs)$
  $babel-otherlangs$,
$endfor$
$if(babel-lang)$
  $babel-lang$,
$endif$
$if(fontsize)$
  $fontsize$,
$endif$
$if(papersize)$
  $papersize$paper,
$endif$
$for(classoption)$
  $classoption$$sep$,
$endfor$
]{$documentclass$}
\usepackage{xcolor}
$if(geometry)$
\usepackage[$for(geometry)$$geometry$$sep$,$endfor$]{geometry}
$endif$
\usepackage{amsmath,amssymb}
\setcounter{secnumdepth}{$if(numbersections)$$if(secnumdepth)$$secnumdepth$$else$2$endif$$else$-\maxdimen$endif$}
$unicam-fonts.latex()$
$unicam-font-settings.latex()$
$unicam-common.latex()$
$unicam-style.latex()$
$for(header-includes)$
$header-includes$
$endfor$
$unicam-after-header-includes.latex()$
$unicam-hypersetup.latex()$
$unicam-style-late.latex()$

$if(title)$
\title{$title$}
$endif$

\begin{document}
\frontmatter
$unicam-titlepage.latex()$
$if(unicam-acknowledgements)$

$unicam-acknowledgements$
$endif$

$for(include-before)$
$include-before$

$endfor$
$if(toc)$
$if(toc-title)$
\renewcommand*\contentsname{$toc-title$}
$endif$
{
\hypersetup{linkcolor=$if(toccolor)$$toccolor$$else$black$endif$}
\setcounter{tocdepth}{$if(toc-depth)$$toc-depth$$else$2$endif$}
\tableofcontents
}
$endif$
$if(lol)$
