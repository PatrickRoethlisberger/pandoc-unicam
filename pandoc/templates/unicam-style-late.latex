$-- Applied after header-includes, so it can restyle what pandoc-crossref defines there.
\makeatletter
% Listings are not floats: like the reference template's, they stay where they are
% written, may break across pages, and carry their caption below. pandoc-crossref
% opens the environment with \caption{...}\label{...}; the caption is collected and
% typeset after the code, while the counter is stepped up front so that \label binds.
\@ifundefined{c@codelisting}{}{%
  \renewenvironment{codelisting}{%
    \par\addvspace{\medskipamount}%
    \refstepcounter{codelisting}%
    \let\caption\unicam@collectcaption
  }{%
    \par\@makecaption{\csname fname@codelisting\endcsname~\thecodelisting}{\unicam@caption}%
    \par\addvspace{\medskipamount}%
  }%
  \long\def\unicam@collectcaption#1{%
    \gdef\unicam@caption{#1}%
    \addcontentsline{lop}{codelisting}{\protect\numberline{\thecodelisting}{\ignorespaces #1}}%
  }%
  \gdef\unicam@caption{}%
}
\makeatother

% Code blocks: grey box (Pandoc only draws one when the highlight style has a background)
\makeatletter\@ifundefined{Shaded}{}{%
  \usepackage{framed}%
  \renewenvironment{Shaded}{\begin{snugshade}}{\end{snugshade}}%
}
\makeatother
